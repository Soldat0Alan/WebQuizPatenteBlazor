@page "/quiz"
@using WebPatenteQuiz.Components.Aggiuntivi;
<PageTitle>Quiz per argomento</PageTitle>
@inject List<Domanda> listaDomande
@inject List<Suggerimento> listaSuggerimenti
@inject List<Argomento> listaArgomenti

@if (IdCapitolo == null || !listaArgomenti.Any(a => a.IdCapitolo == IdCapitolo) )
{
    <p>L'argomento inserito non è esistente. Torna alla pagina dei <a href="quiz-per-argomento">Quiz Per Argomento</a>.</p>
}
else
{
    <SchedaQuiz
        IdCapitolo="@IdCapitolo"
        ListaDomande="listaDomande"
        ListaSuggerimenti="listaSuggerimenti"/>
}

@code {

    [Parameter]
    [SupplyParameterFromQuery(Name = "IdCapitolo")]
    public string? IdCapitoloQuery { get; set; }
    public int IdCapitolo => int.TryParse(IdCapitoloQuery, out int n) ? n : 0;

}


